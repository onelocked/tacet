+// Windows that miss the precomputed blur path would otherwise each pay for their own live blur
+// pass, which scales with the window count and is what makes overview blur expensive on weak GPUs.
+// When those windows are not allowed to fall back, drop the blur instead of paying per window.
+static void dropOverviewWindowBlur(const PHLWINDOW& window, size_t firstElement) {
+    if (!window)
+        return;
+
+    auto& passElements = Render::IHyprRenderer::currentPass(g_pHyprRenderer->context()).m_passElements;
+    for (size_t i = firstElement; i < passElements.size(); ++i) {
+        const auto& passElement = passElements[i];
+        if (!passElement.element)
+            continue;
+
+        auto* surfacePassElement = dc<CSurfacePassElement*>(passElement.element.get());
+        if (!surfacePassElement || surfacePassElement->m_data.pWindow != window)
+            continue;
+
+        surfacePassElement->m_data.blur                 = false;
+        surfacePassElement->m_data.blockBlurOptimization = true;
+    }
+}
