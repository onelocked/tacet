diff --git a/crates/systemctl-tui/src/config.rs b/crates/systemctl-tui/src/config.rs
new file mode 100644
--- /dev/null
+++ b/crates/systemctl-tui/src/config.rs
@@ -0,0 +1,126 @@
+//! Optional colour overrides, e.g. to match a base16 terminal theme.
+//!
+//! Read from `<config dir>/config.toml` (see `systemctl-tui --version`) or from `--config <path>`.
+//! Deliberately a tiny hand-rolled parser rather than a TOML dependency: one `key = "#rrggbb"` per
+//! line, `#` starts a comment outside quotes, unknown keys and unparseable values are warned about
+//! and ignored.
+
+use std::path::Path;
+
+use anyhow::{Context, Result};
+use ratatui::style::Color;
+use tracing::warn;
+
+use crate::utils::get_config_dir;
+
+#[derive(Default, Clone, Copy)]
+pub struct Config {
+  pub accent: Option<Color>,
+  pub border: Option<Color>,
+  pub selection: Option<Color>,
+  pub primary: Option<Color>,
+}
+
+impl Config {
+  /// Explicit path from `--config`. Missing or unreadable is an error.
+  pub fn load(path: &Path) -> Result<Self> {
+    let text = std::fs::read_to_string(path).with_context(|| format!("reading config file {}", path.display()))?;
+    Ok(Self::parse(&text))
+  }
+
+  /// `<config dir>/config.toml` if it exists, defaults otherwise.
+  pub fn load_default() -> Self {
+    let Some(dir) = get_config_dir().ok() else {
+      return Self::default();
+    };
+    // `SYSTEMCTL_TUI_CONFIG` may point at a config file as well as a directory.
+    let path = if dir.is_file() { dir } else { dir.join("config.toml") };
+    match std::fs::read_to_string(&path) {
+      Ok(text) => Self::parse(&text),
+      Err(e) if e.kind() == std::io::ErrorKind::NotFound => Self::default(),
+      Err(e) => {
+        warn!("Ignoring config file {}: {e}", path.display());
+        Self::default()
+      },
+    }
+  }
+
+  fn parse(text: &str) -> Self {
+    let mut config = Self::default();
+    for (i, line) in text.lines().enumerate() {
+      let line = strip_comment(line).trim();
+      let Some((key, value)) = line.split_once('=') else {
+        continue;
+      };
+      let (key, value) = (key.trim(), value.trim().trim_matches('"'));
+      let Some(color) = parse_color(value) else {
+        warn!("Config line {}: expected {key} = \"#rrggbb\", got {value:?}", i + 1);
+        continue;
+      };
+      match key {
+        "accent" => config.accent = Some(color),
+        "border" => config.border = Some(color),
+        "selection" => config.selection = Some(color),
+        "primary" => config.primary = Some(color),
+        other => warn!("Config line {}: unknown key {other:?}", i + 1),
+      }
+    }
+    config
+  }
+}
+
+/// A `#` inside a quoted value is part of a colour, not a comment.
+fn strip_comment(line: &str) -> &str {
+  let mut in_quotes = false;
+  for (i, c) in line.char_indices() {
+    match c {
+      '"' => in_quotes = !in_quotes,
+      '#' if !in_quotes => return &line[..i],
+      _ => {},
+    }
+  }
+  line
+}
+
+fn parse_color(value: &str) -> Option<Color> {
+  let hex = value.strip_prefix('#')?;
+  if hex.len() != 6 {
+    return None;
+  }
+  // Parse the whole thing at once: slicing at fixed byte offsets would panic on non-ASCII input.
+  let rgb = u32::from_str_radix(hex, 16).ok()?;
+  Some(Color::Rgb((rgb >> 16) as u8, (rgb >> 8) as u8, rgb as u8))
+}
+
+#[cfg(test)]
+mod tests {
+  use super::*;
+
+  #[test]
+  fn parses_base16_colors_and_comments() {
+    let config = Config::parse(
+      "# a comment line\naccent = \"#c5c0ff\"  # focused border\n\n[theme]\nborder = \"#4D415F\"\nselection =\"#313245\"\n",
+    );
+    assert_eq!(config.accent, Some(Color::Rgb(0xc5, 0xc0, 0xff)));
+    assert_eq!(config.border, Some(Color::Rgb(0x4d, 0x41, 0x5f)));
+    assert_eq!(config.selection, Some(Color::Rgb(0x31, 0x32, 0x45)));
+    assert_eq!(config.primary, None);
+  }
+
+  #[test]
+  fn ignores_bad_values_and_unknown_keys() {
+    let config = Config::parse("accent = \"#fff\"\nbogus = \"#c5c0ff\"\nprimary = \"not-a-color\"\n");
+    assert_eq!(config.accent, None);
+    assert_eq!(config.primary, None);
+  }
+
+  #[test]
+  fn non_ascii_value_is_ignored_instead_of_panicking() {
+    assert_eq!(Config::parse("accent = \"#✓abc\"\n").accent, None);
+  }
+
+  #[test]
+  fn missing_file_is_not_an_error() {
+    assert!(Config::load(Path::new("/nonexistent/config.toml")).is_err());
+  }
+}
